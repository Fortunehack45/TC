{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/p/:slug*",
      "destination": "/api/article?slug=:slug*"
    },
    {
      "source": "/article/:slug*",
      "destination": "/api/article?slug=:slug*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "article"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebook|twitter|whatsapp|telegram|slack|discord|linkedin|applebot|preview|embed|meta|fetch|curl|wget).*"
        }
      ],
      "destination": "/api/article"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
