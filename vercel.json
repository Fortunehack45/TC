{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/p/:slug*",
      "destination": "/api/article?slug=:slug*"
    },
    {
      "source": "/article/:slug*",
      "destination": "/api/article?slug=:slug*"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "article"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebook|[tT]witter|[tT]elegram|[lL]inked[iI]n|[sS]lack|[dD]iscord|[bB]ot|[cC]rawler|[sS]pider|[pP]review|[aA]pplebot).*"
        }
      ],
      "destination": "/api/article"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
